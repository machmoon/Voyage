<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's entitlements while VOYAGE_SCREEN_TIME is YES (Debug today; see
  project.yml). Voyage.entitlements plus Family Controls, as in Foqos's
  Foqos/foqos.entitlements (awaseem/foqos@4f6864c). Kept by hand: XcodeGen
  generates only Voyage.entitlements, the Release file.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.patrickliu.voyage</string>
	</array>
</dict>
</plist>
